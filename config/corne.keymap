#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0
#define SYMBOLS_L 1
#define ARROWS_L  2
#define NUMBERS_L 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_cb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <7 8>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_cb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_sb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <7 19>;
        };

        right_sb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "0";
            bindings = <
&trans  &kp Q               &kp W           &kp E             &kp R               &kp T            &kp Y  &kp U                &kp I              &kp O            &kp P                   &trans
&trans  &hm LEFT_CONTROL A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_COMMAND F  &kp G            &kp H  &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_COMMAND SEMI  &trans
&trans  &kp LEFT_SHIFT      &kp X           &kp C             &kp V               &kp B            &kp N  &kp M                &kp COMMA          &kp DOT          &kp FSLH                &trans
                                            &kp Z             &lt 1 SPACE         &kp BACKSPACE    &mo 2  &kp ENTER            &bt BT_CLR_ALL
            >;
        };

        number_layer {
            label = "1";
            bindings = <
&trans  &kp N1          &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans          &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                &to 0   &trans  &trans    &trans  &trans  &to 2
            >;
        };

        bt_layer {
            label = "2";
            bindings = <
&trans  &kp ESC  &none           &kp UP_ARROW    &none               &trans                 &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS   &kp BACKSLASH  &kp MINUS         &trans
&trans  &kp TAB  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW     &kp LC(LG(Q))          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp COLON      &kp SINGLE_QUOTE  &trans
&trans  &trans   &trans          &trans          &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)    &kp GRAVE         &kp EQUAL          &kp COMMA              &kp DOT        &kp SLASH         &trans
                                 &to 0           &kp LEFT_COMMAND    &trans                 &trans            &trans             &to 3
            >;
        };

        arrow_layer {
            label = "3";
            bindings = <
&none  &none           &kp UP_ARROW    &none      &sys_reset  &none     &none   &none  &none  &none  &none  &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none       &none     &none   &none  &none  &none  &none  &none
&none  &trans          &none           &none      &none       &none     &none   &none  &none  &none  &none  &none
                                       &to 0      &none       &trans    &trans  &none  &none
            >;
        };
    };
};
