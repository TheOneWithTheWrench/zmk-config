#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0
#define SYMBOLS_L 1
#define ARROWS_L  2
#define NUMBERS_L 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_paren {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <19 20>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_paren {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <20 21>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_cb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <7 8>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_cb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <8 9>;
            require-prior-idle-ms = <280>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_sb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <7 19>;
        };

        right_sb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "0";
            bindings = <
&trans  &kp Q               &kp W           &kp E             &kp R               &kp T            &kp Y   &kp U                &kp I              &kp O            &kp P                   &trans
&trans  &hm LEFT_COMMAND A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LEFT_CONTROL F  &kp G            &kp H   &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_COMMAND SEMI  &trans
&trans  &kp Z               &kp X           &kp C             &kp V               &kp B            &kp N   &kp M                &kp COMMA          &kp DOT          &kp FSLH                &trans
                                            &trans            &kp SPACE           &kp BACKSPACE    &trans  &kp ENTER            &to 1
            >;
        };

        number_layer {
            label = "1";
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none
&none  &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &none
&none  &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &none
                       &to 0   &none   &trans    &trans  &none   &to 2
            >;
        };

        bt_layer {
            label = "2";
            bindings = <
&kp ESC       &kp LS(N1)    &kp LS(N2)      &kp LS(N3)    &kp LS(N4)    &kp LS(N5)     &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &none
&none         &none         &kp LEFT_ARROW  &kp DEL       &kp RIGHT     &bt BT_CLR     &none       &none       &none       &none       &none       &none
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1  &bt BT_SEL 0  &bootloader    &none       &none       &none       &none       &none       &none
                                            &to 0         &none         &trans         &trans      &none       &to 3
            >;
        };

        arrow_layer {
            label = "3";
            bindings = <
&none  &none           &kp UP_ARROW    &none      &sys_reset  &none     &none   &none  &none  &none  &none  &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none       &none     &none   &none  &none  &none  &none  &none
&none  &none           &none           &none      &none       &none     &none   &none  &none  &none  &none  &none
                                       &to 0      &none       &trans    &trans  &none  &none
            >;
        };
    };
};
